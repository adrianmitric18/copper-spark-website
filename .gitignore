# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Lighthouse audit reports (generated locally, not versioned)
lh-*.json

# Backup des images gallery avant compression (script optimize-gallery.mjs)
# Permet de revenir aux originaux si besoin, mais pas versionné (~180 MB).
src/assets/gallery/_originals/

# Environment variables — never commit secrets
.env
.env.*
!.env.example

# Backups DB (données clients) — local uniquement, jamais committé
backups/

# TypeScript incremental build cache (generated by `tsc -b`)
*.tsbuildinfo

# Claude Code session metadata (local), mais on versionne les sous-agents projet
.claude/*
!.claude/agents/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
